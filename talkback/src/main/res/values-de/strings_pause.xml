<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- Name of the action that pauses Nika, in the Nika menu, the gesture action list and the menu settings. [CHAR LIMIT=40] -->
    <string name="title_pause_backtalk">Nika pausieren</string>
    <!-- Summary of the Nika menu setting that shows the Pause Nika item. [CHAR LIMIT=NONE] -->
    <string name="summary_pause_backtalk">Schaltet Sprache, Gesten und Tippen und Entdecken aus, bis du Nika fortsetzt.</string>
    <!-- Keyboard shortcut that pauses Nika, or resumes it when it is paused. [CHAR LIMIT=40] -->
    <string name="keycombo_menu_global_pause_backtalk">Nika pausieren oder fortsetzen</string>

    <!-- Spoken when Nika pauses. [CHAR LIMIT=NONE] -->
    <string name="backtalk_paused">Nika pausiert</string>
    <!-- Spoken when Nika resumes after a pause. [CHAR LIMIT=NONE] -->
    <string name="backtalk_resumed">Nika fortgesetzt</string>

    <!-- Title of the notification shown while Nika is paused. [CHAR LIMIT=NONE] -->
    <string name="notification_title_backtalk_paused">Nika ist pausiert</string>
    <!-- Text of the notification shown while Nika is paused. Tapping it resumes Nika. [CHAR LIMIT=NONE] -->
    <string name="notification_message_backtalk_paused">Zum Fortsetzen tippen</string>
    <!-- Name of the notification channel for the notification shown while Nika is paused, in the app's notification settings. [CHAR LIMIT=40] -->
    <string name="notification_channel_backtalk_paused">Nika pausiert</string>

    <!-- Title of the dialog that asks before pausing Nika. [CHAR LIMIT=NONE] -->
    <string name="dialog_title_pause_backtalk">Nika pausieren?</string>
    <!-- Button in the dialog that pauses Nika. [CHAR LIMIT=20] -->
    <string name="dialog_button_pause_backtalk">Pausieren</string>
    <!-- Message of the dialog that asks before pausing Nika. [CHAR LIMIT=NONE] -->
    <string name="dialog_message_pause_backtalk">Während Nika pausiert ist, spricht es nicht und reagiert nicht auf Gesten. Der Bildschirm funktioniert so, als wäre kein Screenreader aktiv.</string>
    <!-- How to resume Nika when it resumes at the lock screen. [CHAR LIMIT=NONE] -->
    <string name="message_resume_keyguard">Zum Fortsetzen die Benachrichtigung „Nika ist pausiert“ antippen, die Leisertaste dreimal schnell drücken oder das Telefon sperren und wieder aufwecken, sodass der Sperrbildschirm erscheint.</string>
    <!-- How to resume Nika when it resumes when the screen turns on. [CHAR LIMIT=NONE] -->
    <string name="message_resume_screen_on">Zum Fortsetzen die Benachrichtigung „Nika ist pausiert“ antippen, die Leisertaste dreimal schnell drücken oder den Bildschirm aus- und wieder einschalten.</string>
    <!-- How to resume Nika when it only resumes from the notification or a shortcut. [CHAR LIMIT=NONE] -->
    <string name="message_resume_manual">Zum Fortsetzen die Benachrichtigung „Nika ist pausiert“ antippen oder die Leisertaste dreimal schnell drücken.</string>
    <!-- Added to the pause dialog when a keyboard shortcut is set for pausing and resuming Nika. [CHAR LIMIT=NONE] -->
    <string name="message_resume_key_combo">Du kannst auch <xliff:g id="key_combo" example="Alt + P">%1$s</xliff:g> drücken.</string>

    <!-- Title of the setting for when Nika resumes after a pause. [CHAR LIMIT=NONE] -->
    <string name="title_pref_resume_backtalk">Nika fortsetzen</string>
    <!-- Setting value: Nika resumes when the lock screen shows. [CHAR LIMIT=NONE] -->
    <string name="value_resume_keyguard">Wenn der Sperrbildschirm angezeigt wird</string>
    <!-- Setting value: Nika resumes when the screen turns on. [CHAR LIMIT=NONE] -->
    <string name="value_resume_screen_on">Wenn der Bildschirm eingeschaltet wird</string>
    <!-- Setting value: Nika resumes only from the notification or a shortcut. [CHAR LIMIT=NONE] -->
    <string name="value_resume_manual">Nur über die Benachrichtigung oder eine Tastenkombination</string>
</resources>
